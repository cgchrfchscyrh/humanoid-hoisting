---
import { Icon } from "astro-icon/components";
import { project, asset } from "../data/project";
const links = [
  {
    name: "Paper",
    url: project.paperUrl || asset("paper/"),
    icon: "ri:file-text-line",
  },
  { name: "Video", url: "#demo", icon: "ri:play-circle-line" },
  {
    name: "Supplementary",
    url: asset("supplementary/"),
    icon: "ri:attachment-2",
  },
  ...(project.codeUrl
    ? [{ name: "Code", url: project.codeUrl, icon: "ri:github-line" }]
    : []),
  ...(project.arxivUrl
    ? [{ name: "arXiv", url: project.arxivUrl, icon: "academicons:arxiv" }]
    : []),
];
---

<header class="comparison-hero" id="top">
  <div class="hero-intro">
    <h1><span class="hero-name">HOIST</span><span class="hero-paper-title">{project.subtitle}</span></h1>
  </div>
  <div class="hero-publication">
    <div class="authors">
      {
        project.authors.map((author) => (
          <span>
            <a href={`mailto:${author.email}`}>{author.name}</a>
            {author.note && <sup>{author.note}</sup>}
          </span>
        ))
      }
    </div>
    <p class="author-notes">
      <span>* Equal contribution</span><span>† Corresponding author</span>
    </p>
    <div class="resource-links">
      {
        links.map((link) => (
          <a class="button" href={link.url}>
            <>
              <Icon name={link.icon} />
              <span>{link.name}</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
  <div class="hero-stage">
    <div class="hero-scenes">
      <figure class="hero-scene">
        <video
          id="construction-clip"
          controls
          muted
          playsinline
          preload="metadata"
          width="640"
          height="480"
          poster={asset("media/construction-guidance-poster.jpg")}
          aria-label="Construction context: workers guide a crane-suspended concrete cap"
          aria-describedby="construction-scene-caption construction-visual-description"
        >
          <source
            src={asset("media/construction-guidance.mp4")}
            type="video/mp4"
          />
          <track
            kind="descriptions"
            src={asset("media/construction-guidance-descriptions.vtt")}
            srclang="en"
            label="English visual descriptions"
          />
          <a href={asset("media/construction-guidance.mp4")}
            >Download the construction excerpt.</a
          >
        </video>
        <figcaption id="construction-scene-caption">
          <span class="scene-index">Construction</span><strong
            >Human guidance</strong
          ><span
            >Construction footage · <a
              href="https://www.dvidshub.net/video/760467/crane-2"
              >U.S. Navy / DVIDS</a
            ></span
          >
        </figcaption>
      </figure>
      <figure class="hero-scene">
        <video
          id="robot-clip"
          controls
          muted
          playsinline
          preload="metadata"
          width="384"
          height="432"
          poster={asset("media/hoist-guidance-poster.jpg")}
          aria-label="HOIST laboratory demonstration: a humanoid guides a suspended box toward its target"
          aria-describedby="robot-scene-caption robot-visual-description"
        >
          <source src={asset("media/hoist-guidance.mp4")} type="video/mp4" />
          <track
            kind="descriptions"
            src={asset("media/hoist-guidance-descriptions.vtt")}
            srclang="en"
            label="English visual descriptions"
          />
          <a href={asset("media/hoist-guidance.mp4")}
            >Download the HOIST laboratory excerpt.</a
          >
        </video>
        <figcaption id="robot-scene-caption">
          <span class="scene-index">HOIST</span><strong
            >Humanoid guidance</strong
          ><span>Laboratory experiment</span>
        </figcaption>
      </figure>
    </div>
  </div>
  <div class="hero-playback">
    <button id="hero-playback-toggle" type="button" aria-controls="construction-clip robot-clip hoist-demo" hidden>Pause videos</button>
    <a href="#video-notes">Video descriptions & sources</a>
    <p class="sr-only" id="hero-playback-status" role="status"></p>
  </div>
</header>
<div class="hero-context wide" id="video-notes">
  <details class="hero-media-notes">
    <summary>Video sources and visual descriptions</summary>
    <div class="hero-description-grid">
      <div>
        <p id="construction-visual-description">
          <strong>Left — construction context.</strong> Workers on an unfinished building
          guide a concrete cap hanging from a crane cable. They steady and align the
          piece by hand as it is lowered toward the top of a masonry wall. A wider
          shot shows the cable, the workers, and the surrounding structure.
        </p>
        <p>
          Source: <a href="https://www.dvidshub.net/video/760467/crane-2"
            >“CRANE #2” — U.S. Navy video, Defense VI Records Center / DVIDS</a
          >. Audio removed.
          Listed as public domain in the United States, subject to <a
            href="https://www.dvidshub.net/about/copyright"
            >DVIDS usage conditions</a
          >.
        </p>
        <p class="source-disclaimer">
          The appearance of U.S. Department of War (DoW) visual information does
          not imply or constitute DoW endorsement.
        </p>
        <a href={asset("media/construction-guidance-descriptions.vtt")} download
          >Download construction visual descriptions (WebVTT)</a
        >
      </div>
      <div>
        <p id="robot-visual-description">
          <strong>Right — HOIST laboratory demonstration.</strong> A humanoid approaches
          a gray box suspended from overhead straps. It contacts the box with both
          hands and adjusts its position as the box descends onto a wooden platform,
          toward a marked rectangular target. The robot stops after guiding the payload
          into place.
        </p>
        <p>
          Source: the authors’ <a href="#demo">HOIST research video</a>,
          cropped to the right-hand HOIST panel; playback speed is
          unchanged. This excerpt contains no audio. The two clips show
          different settings and are paired to explain the research motivation.
        </p>
        <a href={asset("media/hoist-guidance-descriptions.vtt")} download
          >Download HOIST visual descriptions (WebVTT)</a
        >
      </div>
    </div>
  </details>
</div>
