---
import { Icon } from "astro-icon/components";
import { project, asset } from "../data/project";
const links = [
  {
    name: "arXiv",
    url: project.paperUrl || asset("paper/"),
    icon: "academicons:arxiv",
  },
  ...(project.codeUrl
    ? [{ name: "Code", url: project.codeUrl, icon: "ri:github-line" }]
    : []),
];
---

<header class="comparison-hero" id="top">
  <div class="hero-intro">
    <h1><span class="hero-name">HOIST</span><span class="hero-paper-title">{project.subtitle}</span></h1>
  </div>
  <div class="hero-publication">
    <div class="authors">
      {
        project.authors.map((author) => (
          <span>
            <a href={`mailto:${author.email}`}>{author.name}</a>
            {author.note && <sup>{author.note}</sup>}
          </span>
        ))
      }
    </div>
    <p class="author-notes">
      <span>* Equal contribution</span><span>† Corresponding author</span>
    </p>
    <div class="resource-links">
      {
        links.map((link) => (
          <a class="button" href={link.url}>
            <>
              <Icon name={link.icon} />
              <span>{link.name}</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
  <div class="hero-stage">
    <div class="hero-scenes">
      <figure class="hero-scene">
        <video
          id="construction-clip"
          controls
          controlslist="nodownload"
          muted
          playsinline
          preload="metadata"
          width="640"
          height="480"
          poster={asset("media/construction-guidance-poster.jpg")}
          aria-label="Construction context: workers guide a crane-suspended concrete cap"
          aria-describedby="construction-visual-description"
        >
          <source
            src={asset("media/construction-guidance.mp4")}
            type="video/mp4"
          />
          <track
            kind="descriptions"
            src={asset("media/construction-guidance-descriptions.vtt")}
            srclang="en"
            label="English visual descriptions"
          />
          Video playback is unavailable. Read the text alternative in the media notes.
        </video>
      </figure>
      <figure class="hero-scene">
        <video
          id="robot-clip"
          controls
          controlslist="nodownload"
          muted
          playsinline
          preload="metadata"
          width="384"
          height="432"
          poster={asset("media/hoist-guidance-poster.jpg")}
          aria-label="HOIST laboratory demonstration: a humanoid guides a suspended box toward its target"
          aria-describedby="robot-visual-description"
        >
          <source src={asset("media/hoist-guidance.mp4")} type="video/mp4" />
          <track
            kind="descriptions"
            src={asset("media/hoist-guidance-descriptions.vtt")}
            srclang="en"
            label="English visual descriptions"
          />
          Video playback is unavailable. Read the text alternative in the media notes.
        </video>
      </figure>
    </div>
  </div>
</header>
