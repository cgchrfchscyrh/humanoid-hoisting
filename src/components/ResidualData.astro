---

<details class="data-details">
  <summary>Read residual-motion chart values as a table</summary><div
    class="table-scroll"
    role="region"
    aria-label="Residual-motion data"
    tabindex="0"
  >
    <table>
      <caption
        >Simulation payload IMU results, mean ± standard deviation</caption
      ><thead
        ><tr
          ><th scope="col">Method</th><th scope="col"
            >Acceleration RMS (m/s²)</th
          ><th scope="col">Acceleration peak (m/s²)</th><th scope="col"
            >Angular velocity RMS (rad/s)</th
          ><th scope="col">Angular velocity peak (rad/s)</th></tr
        ></thead
      ><tbody
        >{
          rows.map((row) => (
            <tr>
              <th scope="row">{row[0]}</th>
              {row.slice(1).map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))
        }</tbody>
    </table>
  </div>
</details>
