---
import ResearchFigure from "./ResearchFigure.astro";
import sim from "../assets/sim-hoist-result.jpg";
import real from "../assets/real-hoist-result.jpg";
const domains = [
  {
    id: "simulation",
    title: "Simulation",
    figure: sim,
    rows: [
      {
        name: "VLA-50",
        rollouts: "0",
        position: 22.44,
        posStd: "1.63",
        yaw: "3.85",
        yawStd: "1.94",
        meets: false,
      },
      {
        name: "HOIST +10",
        rollouts: "10",
        position: 16.92,
        posStd: "2.89",
        yaw: "4.58",
        yawStd: "1.97",
        meets: false,
      },
      {
        name: "HOIST +20",
        rollouts: "20",
        position: 2.54,
        posStd: "0.48",
        yaw: "0.29",
        yawStd: "0.27",
        meets: true,
      },
      {
        name: "HOIST +30",
        rollouts: "30",
        position: 6.25,
        posStd: "7.30",
        yaw: "2.76",
        yawStd: "2.04",
        meets: true,
      },
    ],
    comparison:
      "With 50 demonstrations and 30 RL rollouts, HOIST reaches 6.25 cm mean position error, compared with 18.58 cm for VLA-80 trained on 80 demonstrations.",
  },
  {
    id: "real",
    title: "Real humanoid",
    figure: real,
    rows: [
      {
        name: "VLA-50",
        rollouts: "0",
        position: 9.28,
        posStd: "4.32",
        yaw: "14.50",
        yawStd: "12.46",
        meets: false,
      },
      {
        name: "HOIST +10",
        rollouts: "10",
        position: 7.37,
        posStd: "3.81",
        yaw: "21.00",
        yawStd: "17.09",
        meets: false,
      },
      {
        name: "HOIST +20",
        rollouts: "20",
        position: 6.69,
        posStd: "2.09",
        yaw: "12.10",
        yawStd: "5.78",
        meets: true,
      },
      {
        name: "HOIST +30",
        rollouts: "30",
        position: 6.38,
        posStd: "3.01",
        yaw: "28.90",
        yawStd: "20.15",
        meets: true,
      },
    ],
    comparison:
      "With 50 demonstrations and 30 RL rollouts, HOIST reaches 6.38 cm mean position error, compared with 8.57 cm for VLA-80. Real-platform yaw is not uniformly improved by RL refinement.",
  },
];
---

<div class="results-explorer">
  {
    domains.map((domain) => (
      <section
        id={`panel-${domain.id}`}
        class="result-panel"
        aria-labelledby={`${domain.id}-results-title`}
      >
        <h3 id={`${domain.id}-results-title`}>{domain.title}</h3>
        <div class="comparison-visual">
          <ResearchFigure
            src={domain.figure}
            alt={`${domain.title}: HOIST positioning the suspended payload at the end of a trial`}
            caption="End-of-trial view of HOIST."
          />
        </div>
        <details class="data-details">
          <summary>
            View complete placement results{" "}
            <span>Mean ± standard deviation</span>
          </summary>
          <div
            class="table-scroll"
            role="region"
            aria-label={`${domain.title} result table`}
            tabindex="0"
          >
            <table>
              <>
                <caption>
                  {domain.title}: placement accuracy after RL refinement
                </caption>
                <thead>
                  <tr>
                    <>
                      <th scope="col">Method</th>
                      <th scope="col">RL rollouts</th>
                      <th scope="col">Position (cm) ↓</th>
                      <th scope="col">Yaw (°) ↓</th>
                      <th scope="col">Mean criterion</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {domain.rows.map((row) => (
                    <tr class:list={[row.meets && "criterion-met"]}>
                      <th scope="row">{row.name}</th>
                      <td>{row.rollouts}</td>
                      <td>
                        {row.position.toFixed(2)} ± {row.posStd}
                      </td>
                      <td>
                        {row.yaw} ± {row.yawStd}
                      </td>
                      <td>{row.meets ? "Met" : "Not met"}</td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          <p class="table-note">
            Position is Manhattan error |Δx| + |Δy|. The mean criterion requires
            both mean position error ≤ 7 cm and mean yaw error ≤ 30°. This is
            not a per-trial success rate.
          </p>
        </details>
        <p class="comparison-note">
          <strong>RL versus more demonstrations.</strong> {domain.comparison}
        </p>
      </section>
    ))
  }
</div>
