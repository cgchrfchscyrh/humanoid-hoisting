---
import ResearchFigure from "./ResearchFigure.astro";
import sim from "../assets/sim.png";
import real from "../assets/real.png";
const domains = [
  {
    id: "simulation",
    title: "Simulation",
    figure: sim,
    summary: "From 22.44 cm to 2.54 cm with 20 RL rollouts.",
    description:
      "The +20 rollout policy achieves the lowest mean position and yaw errors in simulation. Additional refinement is not strictly monotonic.",
    rows: [
      {
        name: "VLA-50",
        rollouts: "0",
        position: 22.44,
        posStd: "1.63",
        yaw: "3.85",
        yawStd: "1.94",
        meets: false,
      },
      {
        name: "HOIST +10",
        rollouts: "10",
        position: 16.92,
        posStd: "2.89",
        yaw: "4.58",
        yawStd: "1.97",
        meets: false,
      },
      {
        name: "HOIST +20",
        rollouts: "20",
        position: 2.54,
        posStd: "0.48",
        yaw: "0.29",
        yawStd: "0.27",
        meets: true,
      },
      {
        name: "HOIST +30",
        rollouts: "30",
        position: 6.25,
        posStd: "7.30",
        yaw: "2.76",
        yawStd: "2.04",
        meets: true,
      },
    ],
    comparison:
      "With 50 demonstrations and 30 RL rollouts, HOIST reaches 6.25 cm mean position error, compared with 18.58 cm for VLA-80 trained on 80 demonstrations.",
  },
  {
    id: "real",
    title: "Real humanoid",
    figure: real,
    summary: "From 9.28 cm to 6.38 cm on the real humanoid.",
    description:
      "The +30 rollout policy achieves the lowest mean position error on the real platform. The +20 policy has the lowest mean yaw error.",
    rows: [
      {
        name: "VLA-50",
        rollouts: "0",
        position: 9.28,
        posStd: "4.32",
        yaw: "14.50",
        yawStd: "12.46",
        meets: false,
      },
      {
        name: "HOIST +10",
        rollouts: "10",
        position: 7.37,
        posStd: "3.81",
        yaw: "21.00",
        yawStd: "17.09",
        meets: false,
      },
      {
        name: "HOIST +20",
        rollouts: "20",
        position: 6.69,
        posStd: "2.09",
        yaw: "12.10",
        yawStd: "5.78",
        meets: true,
      },
      {
        name: "HOIST +30",
        rollouts: "30",
        position: 6.38,
        posStd: "3.01",
        yaw: "28.90",
        yawStd: "20.15",
        meets: true,
      },
    ],
    comparison:
      "With 50 demonstrations and 30 RL rollouts, HOIST reaches 6.38 cm mean position error, compared with 8.57 cm for VLA-80. Real-platform yaw is not uniformly improved by RL refinement.",
  },
];
---

<div class="results-explorer" data-results>
  <div
    class="results-tabs"
    role="tablist"
    aria-label="Experimental domain"
    hidden
  >
    {
      domains.map((domain, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${domain.id}`}
          aria-controls={`panel-${domain.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {domain.title}
        </button>
      ))
    }
  </div>
  {
    domains.map((domain) => (
      <section id={`panel-${domain.id}`} class="result-panel" data-result-panel>
        <div class="result-intro">
          <>
            <span class="eyebrow">{domain.title}</span>
            <h3>{domain.summary}</h3>
            <p>{domain.description}</p>
          </>
        </div>
        <div class="results-grid">
          <div
            class="error-chart"
            aria-label={`${domain.title}: mean Manhattan placement error in centimeters`}
          >
            <div class="chart-heading">
              <>
                <strong>Position error</strong>
                <span>cm · lower is better ↓</span>
              </>
            </div>
            {domain.rows.map((row) => (
              <div
                class:list={["bar-row", row.name === "VLA-50" && "baseline"]}
              >
                <div class="bar-label">
                  <span>{row.name}</span>
                  <strong>
                    {row.position.toFixed(2)} <small>cm</small>
                  </strong>
                </div>
                <div class="bar-track">
                  <div
                    class="bar-fill"
                    style={`width: ${(row.position / 25) * 100}%`}
                  />
                </div>
              </div>
            ))}
            <p class="chart-note">
              50 demonstrations for every policy. +10 / +20 / +30 indicate
              cumulative RL rollouts.
            </p>
          </div>
          <div class="comparison-visual">
            <ResearchFigure
              src={domain.figure}
              alt={`${domain.title} comparison of VLA-50, VLA-80, and HOIST positioning the suspended payload`}
              caption="Qualitative comparison at 1× speed in the accompanying video."
            />
          </div>
        </div>
        <details class="data-details">
          <summary>
            View complete placement results{" "}
            <span>Mean ± standard deviation</span>
          </summary>
          <div
            class="table-scroll"
            role="region"
            aria-label={`${domain.title} result table`}
            tabindex="0"
          >
            <table>
              <>
                <caption>
                  {domain.title}: placement accuracy after RL refinement
                </caption>
                <thead>
                  <tr>
                    <>
                      <th scope="col">Method</th>
                      <th scope="col">RL rollouts</th>
                      <th scope="col">Position (cm) ↓</th>
                      <th scope="col">Yaw (°) ↓</th>
                      <th scope="col">Mean criterion</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {domain.rows.map((row) => (
                    <tr class:list={[row.meets && "criterion-met"]}>
                      <th scope="row">{row.name}</th>
                      <td>{row.rollouts}</td>
                      <td>
                        {row.position.toFixed(2)} ± {row.posStd}
                      </td>
                      <td>
                        {row.yaw} ± {row.yawStd}
                      </td>
                      <td>{row.meets ? "Met" : "Not met"}</td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          <p class="table-note">
            Position is Manhattan error |Δx| + |Δy|. The mean criterion requires
            both mean position error ≤ 7 cm and mean yaw error ≤ 30°. This is
            not a per-trial success rate.
          </p>
        </details>
        <p class="comparison-note">
          <strong>RL versus more demonstrations.</strong> {domain.comparison}
        </p>
      </section>
    ))
  }
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-results]").forEach((root) => {
    const list = root.querySelector<HTMLElement>("[role=tablist]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [
      ...root.querySelectorAll<HTMLElement>("[data-result-panel]"),
    ];
    if (!list) return;
    list.hidden = false;
    panels.forEach((panel, i) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tabs[i].id);
      panel.tabIndex = 0;
    });
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const index =
          event.key === "ArrowRight"
            ? (i + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : -1;
        if (index >= 0) {
          event.preventDefault();
          select(index, true);
        }
      });
    });
    select(0);
  });
</script>
