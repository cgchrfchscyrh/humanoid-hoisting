<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>("video")];
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (navigator as Navigator & {
    connection?: { saveData?: boolean; addEventListener?: (type: string, listener: () => void) => void };
  }).connection;
  const pausedByUser = new Set<HTMLVideoElement>();
  const internalPauses = new Set<HTMLVideoElement>();
  const visible = new Set<HTMLVideoElement>();
  const autoplayAllowed = () => !document.hidden && !motion.matches && !connection?.saveData;
  const pause = (video: HTMLVideoElement) => {
    if (!video.paused) {
      internalPauses.add(video);
      video.pause();
    }
  };
  const play = async (video: HTMLVideoElement) => {
    if (!video.paused || pausedByUser.has(video) || !visible.has(video) || !autoplayAllowed()) return;
    video.muted = true;
    try { await video.play(); }
    catch { /* Native controls remain available when autoplay is blocked. */ }
    if (!visible.has(video) || document.hidden) pause(video);
  };
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting && entry.intersectionRatio >= 0.2) {
        visible.add(video);
        void play(video);
      } else {
        visible.delete(video);
        pause(video);
      }
    }
  }, { threshold: [0, 0.2] });
  for (const video of videos) {
    video.muted = true;
    video.loop = true;
    video.addEventListener("play", () => {
      // Native play is an explicit choice, including with reduced motion or Save-Data.
      pausedByUser.delete(video);
    });
    video.addEventListener("pause", () => {
      if (internalPauses.has(video)) internalPauses.delete(video);
      else pausedByUser.add(video);
    });
    observer.observe(video);
  }
  const preferencesChanged = () => {
    for (const video of videos) {
      if (!autoplayAllowed()) pause(video);
      else if (visible.has(video)) void play(video);
    }
  };
  motion.addEventListener("change", preferencesChanged);
  connection?.addEventListener?.("change", preferencesChanged);
  document.addEventListener("visibilitychange", () => {
    for (const video of videos) {
      if (document.hidden) pause(video);
      else if (visible.has(video)) void play(video);
    }
  });
</script>
