---
import "@fontsource-variable/ibm-plex-sans";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import { Content } from "../paper.mdx";
import { project, asset } from "../data/project";
const canonical = Astro.site
  ? new URL(import.meta.env.BASE_URL, Astro.site).href
  : undefined;
const absolute = (path: string) =>
  Astro.site ? new URL(asset(path), Astro.site).href : asset(path);
const scholarlyData = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: project.title,
  description: project.description,
  author: project.authors.map((a) => ({ "@type": "Person", name: a.name })),
  ...(canonical ? { url: canonical } : {}),
  isAccessibleForFree: true,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={project.description} />
    <meta name="theme-color" content="#202020" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{project.title}</title>
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={project.title} />
    <meta property="og:description" content={project.description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absolute("media/social-preview.jpg")} />
    <meta
      property="og:image:alt"
      content="HOIST humanoid robot experiment with an externally suspended payload"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="citation_title" content={project.title} />
    {
      project.authors.map((a) => (
        <meta name="citation_author" content={a.name} />
      ))
    }
    <meta
      name="citation_pdf_url"
      content={project.paperUrl || absolute("papers/hoist.pdf")}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(scholarlyData).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><Content /></main>
    <SiteFooter />
  </body>
</html>
